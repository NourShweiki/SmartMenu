# Copy to .env.local (never committed) and fill in. Local values: `npx supabase status`.
# On Vercel, set the same names in Project Settings -> Environment Variables.

# Supabase API URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (low-privilege) key — safe in the browser; RLS + public functions limit it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base domain restaurants live under: <slug>.<APP_ROOT_DOMAIN>. Defaults to "localhost"
# (open http://demo-dinein.localhost:3000). Production: the real app domain.
APP_ROOT_DOMAIN=localhost

# Optional, local only: log every Supabase call with its duration (performance profiling).
# DEBUG_SUPABASE=1

# SERVER-ONLY secret key (bypasses RLS): used to place customer orders. Never NEXT_PUBLIC_, never in the browser.
# Local: `npx supabase status -o env` (SERVICE_ROLE_KEY). On Vercel: set it as a server-side variable only.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, SERVER-ONLY: the AI service that drafts a menu from a photo or PDF (Menu -> Import). Without it the
# feature is simply not offered. Every draft costs money on this key's account; never NEXT_PUBLIC_, never in the browser.
# ANTHROPIC_API_KEY=
# Optional: which model reads the menu (default: claude-sonnet-5-5).
# MENU_IMPORT_MODEL=
